# Phoenix DJ settings. Copy to .env (never commit .env). Tokens: ./add-token.sh main | helper (hidden prompt).
# Main app "Phoenix DJ": the only one that registers slash commands and receives interactions (over the gateway, no endpoint URL).
MAIN_TOKEN=
MAIN_APP_ID=1569676079134810164
GUILD_ID=1328821938243637381
# Helper apps Phoenix DJ 1..5: comma-separated bot tokens, one app each. Max 6 rooms total (main + 5).
HELPER_TOKENS=
# Lavalink (audio engine). On the PC this is the shared home engine on 127.0.0.1:2333 (see DEPLOY.md).
LAVALINK_HOST=127.0.0.1:2333
# LAVALINK_PASSWORD: on the PC it comes from ~/norex-dj-home/.env (the shared home engine). Set it here only for another host.
# Where rooms, playlists and emoji IDs are kept.
DATA_DIR=./data
# Optional: role IDs allowed to use manager-only commands (force skip, /hype). Members with Manage Server always can.
MANAGER_ROLE_IDS=
# Optional: your Discord user ID, to get a DM when YouTube playback breaks or is fixed.
ALERT_USER_ID=
